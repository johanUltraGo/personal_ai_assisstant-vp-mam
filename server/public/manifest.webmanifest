{
  "name": "Vice Principal AI",
  "short_name": "VP Assistant",
  "description": "Daily planning, reminders and reviewed messages for the Vice Principal.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#2b4a8b",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Talk to assistant", "short_name": "Talk", "url": "/#assistant-section", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's work list", "short_name": "Today", "url": "/#morning-list-section", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
