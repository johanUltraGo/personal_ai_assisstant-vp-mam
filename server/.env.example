# Copy this file to .env and fill in real values. Never commit .env.
# Setup steps for each item are in server/README.md.

# --- Database -----------------------------------------------------------------
# Local SQLite for now. To move to Supabase/Postgres: change the Prisma datasource
# provider to "postgresql", set this to the Supabase connection string, and
# regenerate migrations (hosting region still to be confirmed — spec §11).
DATABASE_URL="file:./dev.db"

# --- Access -------------------------------------------------------------------
# Required whenever the server is reachable from another device (her phone).
# Without it, only requests from this same computer are answered.
# Use 6+ digits or a passphrase.
APP_ACCESS_PIN=
# Set to true when served over https behind a proxy.
COOKIE_SECURE=
# The https address she opens, e.g. https://vp.example.org — needed when a
# proxy changes the Host header, so the page's own requests are recognised.
PUBLIC_ORIGIN=
# Network interface when a PIN is set (default all). Without a PIN the server
# always listens on 127.0.0.1 only.
HOST=

# --- Assistant (Claude) ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override; default claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Google sign-in (Gmail send + Drive read, several accounts) ----------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/google/oauth/callback
# base64 32-byte key that encrypts stored Google refresh tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Legacy fallback only (1-hour token, used when no account is connected).
GOOGLE_ACCESS_TOKEN=

# --- School calendar ------------------------------------------------------------
# Drive link or file id of the school calendar (.ics, CSV, JSON or Google Sheet).
SCHOOL_CALENDAR_FILE_ID=
# Shown at the end of leave letters and parent notices.
SCHOOL_NAME=

# --- WhatsApp (optional) -----------------------------------------------------------
# Meta WhatsApp Business Cloud API, used only for individuals. Without these,
# and always for groups, the app opens WhatsApp with the message typed.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Phone notifications (Web Push) ------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Attachments -----------------------------------------------------------------
# Folder for uploaded photos/documents. Use a protected persistent volume in
# production; never inside public/. Default: server/uploads (git-ignored).
ATTACHMENT_STORAGE_PATH=

# --- Backups -----------------------------------------------------------------------
# Daily 02:00 snapshot of the SQLite database. Default folder: server/backups
# (git-ignored). Put it on another disk or a synced folder for real safety.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# IANA timezone for the 9:00 AM list, alerts and "today". Confirm with her.
SCHOOL_TIMEZONE=Asia/Kolkata

PORT=4000

# Set to true behind a proxy so wrong-PIN lockout counts each device separately.
TRUST_PROXY=

# Delete assistant chats idle for more than this many days (they may mention
# students). Empty = keep everything. Checked daily at 02:00.
CONVERSATION_RETENTION_DAYS=
