# Copy this file to .env and fill in real values. Never commit .env.
# DATABASE_URL: Prisma datasource. Dev default is local SQLite (see prisma/schema.prisma).
# To move to Supabase/Postgres: change the Prisma datasource provider to "postgresql"
# and set DATABASE_URL to the Supabase connection string, then re-run `npm run prisma:migrate`.
DATABASE_URL="file:./dev.db"

# Required for Phase 3 Claude-based task parsing. Without this, the parser
# endpoint responds with a clear "ANTHROPIC_API_KEY not configured" error.
ANTHROPIC_API_KEY=

# A short-lived Google OAuth access token with Gmail send and Drive read
# scopes. Obtain it through the school's approved Google OAuth consent flow;
# do not commit the token. Without it, Gmail and Drive stay safely blocked.
GOOGLE_ACCESS_TOKEN=
GMAIL_ACCOUNT_LABEL=
DRIVE_ACCOUNT_LABEL=

# Optional legacy OAuth client registration details, retained for the consent
# flow that issues GOOGLE_ACCESS_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta WhatsApp Business Cloud API credentials. Both values are required for
# WhatsApp sending; personal-account or browser automation is not supported.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Local storage for task attachments. Use a protected persistent volume in
# production; do not place this inside a public static directory.
ATTACHMENT_STORAGE_PATH=

# IANA timezone used for the 9:00 AM morning list and the evening planning
# cutoff. Spec does not state her timezone explicitly; defaulting to Indian
# school hours. Confirm with her before relying on this in production.
SCHOOL_TIMEZONE=Asia/Kolkata

PORT=4000
