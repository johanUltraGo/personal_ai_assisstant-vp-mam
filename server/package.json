{
  "name": "vice-principal-ai-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Vice Principal AI Assistant (Phase 1+ foundation).",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-service.ps1",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-server.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-service.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "luxon": "^3.5.0",
    "node-cron": "^4.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
