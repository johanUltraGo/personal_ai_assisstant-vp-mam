{
  "name": "vice-principal-ai-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Vice Principal AI Assistant (Phase 1+ foundation).",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "express": "^4.21.2",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "vitest": "^2.1.4",
    "supertest": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/node-cron": "^3.0.11",
    "@types/luxon": "^3.4.2"
  }
}
