// Phase 1+2 schema. Tables for later phases (evening_plans, contacts,
// messages_sent, calendar_events, connectors, school_app_snapshots,
// attachments) are added in the phases that actually need them, per
// planning.md §9 — they are not pre-created here to avoid building
// unused structure ahead of the requirement that needs it.
//
// Dev datasource is local SQLite (no Postgres/Docker available in this
// environment). To move to Supabase: change provider to "postgresql",
// set DATABASE_URL to the Supabase connection string, then run
// `npm run prisma:migrate`. See planning.md §5 ("Hosting location" — ❓).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite (the local dev datasource) has no native enum support in Prisma,
// so status/source fields are plain strings, validated against the TS
// union types in src/domain/types.ts at the application layer. If/when
// this moves to Supabase/Postgres, these can optionally become real
// Prisma enums without changing any application code.

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String?
  category        String?
  timeWindowStart DateTime
  timeWindowEnd   DateTime
  status          String   @default("DRAFTED")
  source          String   @default("MANUAL")
  carriedOverCount Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  history   TaskHistory[]
  reminders Reminder[]
  attachments Attachment[]
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String?
  originalName String
  storedName   String?  @unique // null for a Drive link
  driveFileId  String?
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model TaskHistory {
  id          String     @id @default(cuid())
  taskId      String
  fromStatus  String?
  toStatus    String
  changedAt   DateTime   @default(now())
  changedBy   String     @default("principal")
  note        String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Reminder {
  id          String   @id @default(cuid())
  taskId      String?
  label       String
  fireAt      DateTime
  status      String   @default("PENDING")
  retryCount  Int      @default(0)
  repeatRule  String?
  createdAt   DateTime @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  log  ReminderLog[]

  @@index([fireAt, status])
}

model ReminderLog {
  id         String   @id @default(cuid())
  reminderId String
  eventType  String
  eventAt    DateTime @default(now())
  details    String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
}

// Phase 3 additions: contacts (for send-by-name resolution) and a
// permanent audit record of every message actually sent, per
// planning.md §5. Nothing here is written to until she gives the single
// "Send?" confirmation (spec §5) — see src/services/messagingService.ts.

model Contact {
  id        String   @id @default(cuid())
  kind      String   @default("PERSON") // PERSON | GROUP (parents' group, teachers' group)
  displayName String
  email     String?
  whatsappNumber String?
  createdAt DateTime @default(now())
}

model MessageSent {
  id          String   @id @default(cuid())
  channel     String // EMAIL | WHATSAPP
  recipient   String
  subject     String?
  body        String
  status      String // SENT | BLOCKED | FAILED | HANDED_OFF
  blockReason String?
  confirmedAt DateTime @default(now())
  pendingMessageId String?
  fromAccount String?
  handoffUrl  String?
}

// A message exactly as it was shown to her with "Send?" (design §4). Only a
// row here can be sent, only once, and only before it expires.
model PendingMessage {
  id               String    @id @default(cuid())
  channel          String // EMAIL | WHATSAPP
  contactId        String
  recipientName    String
  recipientKind    String
  recipientAddress String?
  subject          String?
  body             String
  calendarEventId  String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  cancelledAt      DateTime?
}

// Phase 4: school calendar awareness (spec §6). Rows here are produced
// by syncing the school's Drive calendar file — that sync itself is
// blocked without a configured Drive connector (same credential gap as
// Phase 3's Gmail/Drive), so this model and the "two days before" logic
// are implemented and tested against manually-seeded rows for now. See
// src/services/calendarService.ts and the final report's blocker list.
model CalendarEvent {
  id          String    @id @default(cuid())
  eventName   String
  eventDate   DateTime
  type        String // HOLIDAY | EVENT
  promptedAt  DateTime?
  notifiedAt  DateTime?
  decision    String? // APPROVED | DECLINED
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// What the assistant and its scheduled jobs did, in plain words, so she can
// ask "what are you doing?" (spec §9). Append-only.
model ActivityLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  kind    String
  summary String
  refType String?
  refId   String?

  @@index([at])
}

// A connected Google account (Gmail send + Drive read). Only the encrypted
// refresh token is stored (AES-256-GCM with TOKEN_ENCRYPTION_KEY).
model GoogleAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  label           String?
  scopes          String
  refreshTokenEnc String
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
}

// One conversation with the assistant (design §3). Messages are stored exactly
// as sent/returned (all content blocks, JSON) and only ever appended.
model Conversation {
  id        String   @id @default(cuid())
  kind      String // GENERAL | EVENING_PLAN | MORNING_REPLY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ConversationMessage[]
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  contentJson    String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// She confirmed that day's morning list (spec §3: "confirms or changes it in one reply").
model DayPlanConfirmation {
  date        String   @id // YYYY-MM-DD in the school timezone
  confirmedAt DateTime @default(now())
  via         String // BUTTON | ASSISTANT
}

// A plan the assistant proposed in the evening talk (spec §3). She edits it on
// screen and saves; saving creates the tasks. Older drafts are kept, discarded.
model DayPlanProposal {
  id             String    @id @default(cuid())
  conversationId String?
  planDate       String // YYYY-MM-DD
  itemsJson      String
  status         String    @default("DRAFT") // DRAFT | SAVED | DISCARDED
  createdAt      DateTime  @default(now())
  savedAt        DateTime?
}

// A phone/browser that agreed to receive notifications (Web Push, spec §10).
model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique
  p256dh        String
  auth          String
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
}
